{
  "schema_version": 1,
  "title": "Pressure-resistance experiment CSV contract",
  "claim_boundary": "Only data_origin=experiment may support physical calibration; synthetic_test rows are algorithm tests only.",
  "fields": [
    {"name": "record_id", "type": "text", "required": true},
    {"name": "data_origin", "type": "text", "required": true, "enum": ["experiment", "synthetic_test"]},
    {"name": "condition_id", "type": "text", "required": true},
    {"name": "specimen_id", "type": "text", "required": true},
    {"name": "powder_batch_id", "type": "text", "required": true},
    {"name": "repeat_index", "type": "integer", "required": true, "minimum": 1},
    {"name": "composition_basis", "type": "text", "required": true, "enum": ["mass_fraction", "volume_fraction"]},
    {"name": "al_fraction", "type": "number", "required": true, "minimum": 0.0, "maximum": 1.0},
    {"name": "diamond_fraction", "type": "number", "required": true, "minimum": 0.0, "maximum": 1.0},
    {"name": "specimen_diameter_m", "type": "number", "required": true, "exclusive_minimum": 0.0},
    {"name": "specimen_height_m", "type": "number", "required": true, "exclusive_minimum": 0.0},
    {"name": "cycle_index", "type": "integer", "required": true, "minimum": 1},
    {"name": "measurement_index", "type": "integer", "required": true, "minimum": 1},
    {"name": "loading_stage", "type": "text", "required": true, "enum": ["loading", "dwell", "unloading"]},
    {"name": "pressure_pa", "type": "number", "required": true, "minimum": 0.0},
    {"name": "elapsed_time_s", "type": "number", "required": true, "minimum": 0.0},
    {"name": "dwell_time_s", "type": "number", "required": true, "minimum": 0.0},
    {"name": "specimen_temperature_k", "type": "number", "required": true, "exclusive_minimum": 0.0},
    {"name": "source_mode", "type": "text", "required": true, "enum": ["fixed_voltage", "fixed_current", "resistance_meter"]},
    {"name": "wiring_mode", "type": "text", "required": true, "enum": ["two_wire", "four_wire"]},
    {"name": "applied_voltage_v", "type": "number", "required": false, "minimum": 0.0},
    {"name": "applied_current_a", "type": "number", "required": false, "minimum": 0.0},
    {"name": "measured_voltage_v", "type": "number", "required": false, "minimum": 0.0},
    {"name": "measured_current_a", "type": "number", "required": false, "exclusive_minimum": 0.0},
    {"name": "measured_resistance_ohm", "type": "number", "required": true, "exclusive_minimum": 0.0},
    {"name": "lead_contact_resistance_ohm", "type": "number", "required": false, "minimum": 0.0},
    {"name": "resistance_standard_uncertainty_ohm", "type": "number", "required": true, "minimum": 0.0},
    {"name": "instrument_id", "type": "text", "required": true},
    {"name": "instrument_calibration_date", "type": "date", "required": true},
    {"name": "operator_id", "type": "text", "required": true},
    {"name": "quality_flag", "type": "text", "required": true, "enum": ["accepted", "excluded"]},
    {"name": "notes", "type": "text", "required": false}
  ],
  "cross_field_rules": {
    "composition_sum_absolute_tolerance": 1e-6,
    "voltage_current_resistance_relative_tolerance": 0.02,
    "two_wire_requires_lead_contact_resistance": true,
    "four_wire_lead_contact_resistance_must_be_zero_or_blank": true,
    "fixed_voltage_requires_applied_voltage": true,
    "fixed_current_requires_applied_current": true,
    "condition_invariant_fields": [
      "data_origin", "powder_batch_id", "composition_basis", "al_fraction", "diamond_fraction",
      "cycle_index", "loading_stage", "pressure_pa", "elapsed_time_s", "dwell_time_s",
      "specimen_temperature_k", "source_mode", "wiring_mode"
    ],
    "record_id_unique": true,
    "specimen_repeat_pair_unique_per_condition": true,
    "loading_pressure_nondecreasing_by_measurement_index": true,
    "unloading_pressure_nonincreasing_by_measurement_index": true
  }
}
